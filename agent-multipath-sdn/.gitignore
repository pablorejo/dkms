# Raw pod logs (10-20 MB each, reproducible re-ejecutando la sim).
iterations/*/baseline/*/dkms-*.log
iterations/*/post/*/dkms-*.log

# Loadtest requests CSV (~450 KB cada, reproducible).
iterations/*/baseline/*/data/loadtest_requests.csv
iterations/*/post/*/data/loadtest_requests.csv

# Payload (~12 KB cada, regenerable desde el subcomando + args).
iterations/*/baseline/*/payload.json
iterations/*/post/*/payload.json

# Plots de saturate de cada sim individual (los del bench compare van
# en iterations/iteration_016/plots/, esos sí los queremos).
iterations/*/baseline/*/plots/
iterations/*/post/*/plots/
