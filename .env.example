# ─── Shared ──────────────────────────────────────────────────────────────
RUST_LOG=info,tonic=warn,h2=warn
CONFIG_DIR=./config
NODE_ID=node-1

# ─── Inter-module endpoints (gRPC) ──────────────────────────────────────
QKC_GRPC_ADDR=0.0.0.0:50051
ORR_GRPC_ADDR=0.0.0.0:50052
SDN_GRPC_ADDR=0.0.0.0:50053
DKMS_GRPC_ADDR=0.0.0.0:50054
QUDITTO_GRPC_ADDR=0.0.0.0:50055

# Where each module reaches the others (override per deployment)
QKC_GRPC_URL=http://127.0.0.1:50051
ORR_GRPC_URL=http://127.0.0.1:50052
SDN_GRPC_URL=http://127.0.0.1:50053
DKMS_GRPC_URL=http://127.0.0.1:50054
QUDITTO_GRPC_URL=http://127.0.0.1:50055

# ─── QKC binary TCP hot-path (QKC↔QKC) ──────────────────────────────────
QKC_TCP_BIND=0.0.0.0:7001
QKC_TCP_PEER_TIMEOUT_MS=5000

# ─── DKMS ETSI HTTP API (SAEs face this) ────────────────────────────────
DKMS_HTTP_ADDR=0.0.0.0:8080
DKMS_TLS_CERT=./certs/dkms.crt
DKMS_TLS_KEY=./certs/dkms.key

# ─── SDN admin HTTP API ─────────────────────────────────────────────────
SDN_HTTP_ADDR=0.0.0.0:8081

# ─── quditto (simulated QKD link) ───────────────────────────────────────
QUDITTO_HTTP_ADDR=0.0.0.0:8090
QUDITTO_MAX_BUFFER_SIZE=1048576
QUDITTO_RATE_R0=1000
QUDITTO_RATE_ALPHA=0.001

# ─── mTLS (optional) ────────────────────────────────────────────────────
RUNTIME_MTLS_ENABLED=false
RUNTIME_MTLS_CA=./certs/ca.crt

# ─── Metrics ────────────────────────────────────────────────────────────
METRICS_ADDR=0.0.0.0:9100
